# Copie este arquivo para .env e preencha com os dados do SEU pipe.
# O .env está no .gitignore: nenhum token deste projeto foi ou será publicado.
#
# Deixe PIPEFY_TOKEN ou PIPEFY_PIPE_ID vazio para rodar em modo demonstração
# (os pedidos ficam em dados/pedidos-demo.jsonl, só na sua máquina).

PIPEFY_TOKEN=
PIPEFY_PIPE_ID=
PIPEFY_FASE_ID=

# IDs dos campos do pipe (ver docs/montar-o-pipe.md)
PIPEFY_CAMPO_NOME=
PIPEFY_CAMPO_EMAIL=
PIPEFY_CAMPO_TELEFONE=
PIPEFY_CAMPO_BAIRRO=
PIPEFY_CAMPO_MORADIA=
PIPEFY_CAMPO_TELADO=
PIPEFY_CAMPO_OUTROS_PETS=
PIPEFY_CAMPO_PET=
PIPEFY_CAMPO_PORTE=
PIPEFY_CAMPO_MOTIVO=
PIPEFY_CAMPO_CONSENTIMENTO=

# Texto aleatório qualquer, usado para anonimizar o IP no limite de envios
IP_SAL=
